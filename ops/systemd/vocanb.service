[Unit]
Description=Vocanb SvelteKit service
After=network-online.target wg-quick@wg0.service
Wants=network-online.target wg-quick@wg0.service

[Service]
Type=simple
User=vocanb
Group=vocanb
WorkingDirectory=/opt/vocanb/current
EnvironmentFile=/etc/vocanb/vocanb.env
ExecStart=/opt/node-v24/bin/node /opt/vocanb/current/build/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vocanb

[Install]
WantedBy=multi-user.target
